# Configuracoes da Aplicacao
APP_NAME="PRF Tracker"
SECRET_KEY="sua_chave_secreta_aqui"

# Conexao com Banco de Dados
# Em desenvolvimento local, descomente a linha abaixo para SQLite:
# DATABASE_URL="sqlite:///./estudos_prf.db"

# Em producao (Render/PostgreSQL), preencha com a URL do Neon/Supabase:
DATABASE_URL="postgresql://usuario:senha@host:port/database?sslmode=require"

# Integracao com Inteligencia Artificial (Gemini)
# AI Studio injeta automaticamente esta chave a partir dos segredos do usuario:
GEMINI_API_KEY="sua_chave_gemini_aqui"

# APP_URL: URL base da aplicacao
APP_URL="http://localhost:3000"
